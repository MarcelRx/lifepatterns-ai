# LifePatterns AI - Test Environment Configuration
# This file is for CI/CD testing only
# DO NOT use these credentials in production

ENVIRONMENT=test
DEBUG=True

# Test Database Configuration (PostgreSQL service container)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test_db
DB_USER=test_user
DB_PASSWORD=test_password

# Test Secret Key (for testing only - NOT SECURE)
SECRET_KEY=test-secret-key-for-ci-only-do-not-use-in-production

# Groq API is optional for tests (uses local fallback)
GROQ_API_KEY=

# Encryption disabled for tests
ENCRYPT_DATA=False
