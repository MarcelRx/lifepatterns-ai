# LifePatterns AI - Production Environment Configuration
# Copy this file to .env for production deployment
# Fill in ALL required values before deploying
# DO NOT commit this file with actual values

ENVIRONMENT=production
DEBUG=False

# Database Configuration - REQUIRED
# Option 1: Use DATABASE_URL (recommended for production)
DATABASE_URL=postgresql://user:password@host:port/database

# Option 2: Use individual parameters (alternative to DATABASE_URL)
# DB_HOST=your-production-db-host
# DB_PORT=5432
# DB_NAME=lifepatterns_production
# DB_USER=lifepatterns_user
# DB_PASSWORD=your-secure-production-password

# Secret Key - REQUIRED
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERATE_NEW_SECRET_KEY_HERE

# Groq API - Optional (for AI features)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Data Encryption - Optional
# Set ENCRYPT_DATA=True to enable journal entry encryption
# Generate encryption key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPT_DATA=False
ENCRYPTION_KEY=your-encryption-key-here-if-encrypt-data-is-true

# OpenWeatherMap API - Optional (feature not yet implemented)
OPENWEATHER_API_KEY=your-openweather-api-key

# Database SSL mode (documented but not currently enforced by application code)
# Future implementation should add SSL to PostgreSQL connection string
# Values: disable | allow | prefer | require | verify-ca | verify-full
DB_SSL_MODE=require

# Optional: Redis caching (not implemented yet)
REDIS_ENABLED=False
REDIS_URL=redis://localhost:6379/0
