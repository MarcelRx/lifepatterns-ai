# LifePatterns AI - Local Development Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to git (it's in .gitignore)

# Environment: development | production | test
ENVIRONMENT=development

# Debug mode (True for development, False for production)
DEBUG=True


# Database Configuration - PostgreSQL (REQUIRED)
# -------------------------------------------

# Option 1: Use DATABASE_URL (recommended)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://lifepatterns_user:your_password@localhost:5432/lifepatterns_db

# Option 2: Use individual parameters (alternative to DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lifepatterns_db
DB_USER=lifepatterns_user
DB_PASSWORD=your_secure_password_here

# Database SSL mode (documented but not currently enforced by application code)
# Future implementation should add SSL to PostgreSQL connection string
# Values: disable | allow | prefer | require | verify-ca | verify-full
DB_SSL_MODE=prefer


# Security Configuration (REQUIRED)
# -------------------------------------------

# Secret key for JWT token signing
# IMPORTANT: Generate a new key for your local development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# Data encryption (optional)
ENCRYPT_DATA=False
# If ENCRYPT_DATA=True, generate encryption key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here


# Groq API Configuration (Optional - for AI features)
# -------------------------------------------

# Enable or disable external AI processing (Groq API)
# Set to "true" to use Groq API if GROQ_API_KEY is set
# Default: "false" (uses only local TextBlob analysis, no data sent externally)
ENABLE_EXTERNAL_AI=false

# Get your API key: https://console.groq.com/keys
# If not set, the app will use local TextBlob fallback
GROQ_API_KEY=gsk_your_groq_api_key_here

# Default model for text analysis
# Options: llama-3.1-8b-instant | llama-3.3-70b-versatile | mixtral-8x7b-32768 | gemma-7b-it
GROQ_MODEL=llama-3.1-8b-instant

# Model for complex reasoning (higher quality, slower)
GROQ_REASONING_MODEL=llama-3.3-70b-versatile


# External APIs (Optional)
# -------------------------------------------

# OpenWeatherMap API for weather correlation (feature not yet implemented)
OPENWEATHER_API_KEY=your-openweather-api-key


# Optional Features (Not Yet Implemented)
# -------------------------------------------

# Redis caching (optional)
REDIS_ENABLED=False
REDIS_URL=redis://localhost:6379/0

# Calendar integration (not implemented)
CALENDAR_INTEGRATION=False
