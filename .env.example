# LifePatterns AI - Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to git (it's in .gitignore)


# Application Settings
# -------------------------------------------

# Environment: development | production
ENVIRONMENT=development

# App title shown in browser tab
APP_TITLE=LifePatterns AI

# App version
APP_VERSION=1.0.0

# Debug mode (True for development, False for production)
DEBUG=True


# Database Configuration - PostgreSQL
# -------------------------------------------

# Database type: postgresql | sqlite (fallback)
DATABASE_TYPE=postgresql

# PostgreSQL Connection
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://lifepatterns_user:your_password@localhost:5432/lifepatterns_db

# OR individual connection parameters (alternative to DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lifepatterns_db
DB_USER=lifepatterns_user
DB_PASSWORD=your_secure_password_here

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Enable database SSL in production
DB_SSL_MODE=prefer

# Backup enabled (True/False)
DATABASE_BACKUP=True

# Backup interval in hours
BACKUP_INTERVAL=24


# Groq API Configuration - LLM Inference
# -------------------------------------------

# Get your API key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Default model for text analysis
# Options: llama3-8b-8192 | llama3-70b-8192 | mixtral-8x7b-32768 | gemma-7b-it
GROQ_MODEL=llama3-8b-8192

# Model for complex reasoning (higher quality, slower)
GROQ_REASONING_MODEL=llama3-70b-8192

# Maximum tokens per request
GROQ_MAX_TOKENS=1024

# Temperature for creativity (0.0 = deterministic, 1.0 = creative)
GROQ_TEMPERATURE=0.3

# Timeout in seconds
GROQ_TIMEOUT=30

# Rate limiting (requests per minute)
GROQ_RATE_LIMIT=30

# Fallback to local NLP if Groq unavailable
GROQ_FALLBACK_LOCAL=True


# Local NLP Settings (Fallback/Backup)
# -------------------------------------------

# Enable local TextBlob fallback
USE_LOCAL_NLP_FALLBACK=True

# Cache directory for local models
LOCAL_MODEL_CACHE=models/cache


# Pattern Detection Settings
# -------------------------------------------

# Minimum days of data required for pattern detection
MIN_DAYS_FOR_PATTERN=7

# Confidence threshold for pattern detection (0.0 - 1.0)
PATTERN_CONFIDENCE_THRESHOLD=0.75

# Number of days to analyze for trends
TREND_ANALYSIS_DAYS=30

# Enable advanced ML patterns using scikit-learn
ADVANCED_ML_PATTERNS=True


# Recommendation Engine Settings
# -------------------------------------------

# Minimum confidence % to show recommendation
MIN_RECOMMENDATION_CONFIDENCE=60

# Maximum recommendations per day
MAX_DAILY_RECOMMENDATIONS=3

# Enable personalized recommendations
PERSONALIZED_RECOMMENDATIONS=True

# Use Groq for generating recommendation text
USE_GROQ_FOR_RECOMMENDATIONS=True


# Visualization Settings
# -------------------------------------------

# Default chart theme: plotly | plotly_white | plotly_dark
CHART_THEME=plotly_white

# Primary color (hex without #)
PRIMARY_COLOR=2196F3

# Secondary color (hex without #)
SECONDARY_COLOR=4CAF50

# Enable animations
ENABLE_ANIMATIONS=True


# Security & Privacy
# -------------------------------------------

# Secret key for session management
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# Encrypt sensitive journal entries
ENCRYPT_DATA=False

# Encryption key (generate if ENCRYPT_DATA=True)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here

# Session timeout in minutes
SESSION_TIMEOUT=30


# External APIs (Optional)
# -------------------------------------------

# OpenWeatherMap API for weather correlation
OPENWEATHER_API_KEY=your-openweather-api-key

# Enable calendar integration
CALENDAR_INTEGRATION=False


# Development & Testing
# -------------------------------------------

# Generate sample data on startup
GENERATE_SAMPLE_DATA=True

# Number of sample days to generate
SAMPLE_DATA_DAYS=30

# Enable detailed logging
VERBOSE_LOGGING=True

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log file path
LOG_FILE_PATH=logs/lifepatterns.log


# Performance & Caching
# -------------------------------------------

# Enable Redis caching (optional)
REDIS_ENABLED=False
REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds
CACHE_TTL=3600


# Academic/Thesis Settings
# -------------------------------------------

STUDENT_NAME=Your Name
INSTITUTION=NBI-Handelsakademin
PROGRAM=Mjukvaruutvecklare med inriktning AI
SUPERVISOR_NAME=Supervisor Name